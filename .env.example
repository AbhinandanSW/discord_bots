# ---------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------
# Optional: deploy slash commands to one guild instantly (otherwise global, ~1h).
GUILD_ID=

# Where the SQLite files live. On a host, point this at a mounted volume.
DATA_DIR=./data

LOG_LEVEL=info
DRY_RUN=false

# ---------------------------------------------------------------------------
# BOT 1 - Job scraper
# ---------------------------------------------------------------------------
JOBS_DISCORD_TOKEN=
JOBS_CLIENT_ID=

# Output channels (right-click channel > Copy Channel ID, with Developer Mode on)
JOBS_CHANNEL_FRONTEND=
JOBS_CHANNEL_BACKEND=
JOBS_CHANNEL_FULLSTACK=
# Optional: a channel that gets one summary line per scrape run
JOBS_LOG_CHANNEL_ID=

# Scrape cadence. 0 disables the scheduler (manual /scrape only).
SCRAPE_INTERVAL_MINUTES=180
SCRAPE_ON_START=false
SCRAPE_MAX_POSTS_PER_RUN=10
# How many pending rows to scan when choosing what to post this run
JOBS_MAX_CANDIDATES=300
JOBS_MAX_AGE_DAYS=14
# Minimum classification score before a job is posted
JOBS_MIN_CONFIDENCE=2
# Used when a listing has no frontend/backend signal at all
JOBS_DEFAULT_CATEGORY=fullstack

# Apify. Actor ID looks like "username~actor-name" (or "username/actor-name").
APIFY_TOKEN=
APIFY_ACTOR_ID=
# Exact input JSON your actor expects, e.g.
# {"location":"India","maxItems":100,"remote":true}
APIFY_INPUT_JSON={}
APIFY_MAX_ITEMS=100
APIFY_TIMEOUT_SECS=280

# Optional field-mapping overrides. Comma-separated candidate paths in your
# actor's dataset items (dot paths allowed). Only set what differs.
# APIFY_MAP_TITLE=jobTitle,title
# APIFY_MAP_COMPANY=companyName,employer
# APIFY_MAP_URL=jobUrl,applyUrl
# APIFY_MAP_DESCRIPTION=descriptionHtml,description
# APIFY_MAP_LOCATION=location,city
# APIFY_MAP_SALARY=salary,compensation
# APIFY_MAP_POSTED_AT=postedAt,createdAt
# APIFY_MAP_EMAILS=emails,contactEmails
# APIFY_MAP_TAGS=tags,skills
# APIFY_MAP_SOURCE=source,board

JOBS_HEALTH_PORT=8080

# ---------------------------------------------------------------------------
# BOT 2 - DSA coach
# ---------------------------------------------------------------------------
DSA_DISCORD_TOKEN=
DSA_CLIENT_ID=

# Channel that hosts the per-person threads
DSA_CHANNEL_ID=

# thread = one public thread per person (recommended)
# channel = post in the channel and mention the person
# dm      = slide into their DMs
DSA_MODE=thread

# Defaults for new users
DSA_TIMEZONE=Asia/Kolkata
DSA_HOUR=9
DSA_TICK_MINUTES=5
# An unanswered question expires after this many days
DSA_EXPIRE_DAYS=2
# Send the next question immediately after solving one
DSA_SEND_NEXT_ON_SOLVE=false
DSA_THREAD_ARCHIVE_MINUTES=1440

DSA_HEALTH_PORT=8081
